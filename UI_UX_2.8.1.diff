+QPushButton:disabled, QToolButton:disabled {{ color: {disabled}; background: {raised}; border-color: {border_soft}; }}
+QPushButton[primary="true"] {{ background: {accent}; border: 1px solid {accent}; color: #FFFFFF; font-weight: 600; }}
