+        window="#E8EBEF", chrome="#F4F5F7", surface="#FFFFFF", raised="#F7F8FA",
+        header="#EEF0F3", alt_row="#F6F8FA",
+        border="#C3CAD2", border_soft="#DADFE5", border_strong="#9AA4AF",
+        text="#1E2730", text_strong="#0F171F", muted="#5A6672", faint="#8A949E", disabled="#A3ACB5",
+        accent="#0A5BAA", accent_hover="#084C8F", accent_pressed="#073E75",
+        accent_soft="#E4EEF8", accent_soft_border="#A8C5E6", accent_text="#0A4F94",
+        selection="#CFE1F5", selection_text="#0B2A4A",
+        focus="#2F7CD0", input="#FFFFFF", hover="#ECEFF3", pressed="#E0E5EB",
+        tooltip_bg="#1F2A36", tooltip_text="#F4F7FA",
+        warn_bg="#FFF6E5", warn_border="#E7C27A", warn_text="#6A4705",
+        danger="#B3261E", danger_soft="#FCECEB",
+        scroll="#B9C1CA", scroll_hover="#9AA4AF",
+    ),
+    "dark": dict(
+        window="#16191D", chrome="#1D2126", surface="#22272D", raised="#272C33",
+        header="#2A3037", alt_row="#262B31",
+        border="#3A4149", border_soft="#30363D", border_strong="#525B65",
+        text="#DCE1E6", text_strong="#F2F4F6", muted="#99A3AD", faint="#76808A", disabled="#5F6872",
+        accent="#3D8FDB", accent_hover="#4C9AE2", accent_pressed="#2F7DC6",
+        accent_soft="#1F3348", accent_soft_border="#36638F", accent_text="#8EC1F2",
+        selection="#284866", selection_text="#FFFFFF",
+        focus="#5AA2E6", input="#1B1F24", hover="#2C3239", pressed="#343B43",
+        tooltip_bg="#0F1317", tooltip_text="#EEF1F4",
+        warn_bg="#33291A", warn_border="#7D6130", warn_text="#F0D9A8",
+        danger="#E26D64", danger_soft="#3A2321",
