+
+QT_PALETTE_ROLES = {
+    "Window": "window", "WindowText": "text", "Base": "input", "AlternateBase": "alt_row",
+    "Text": "text", "Button": "surface", "ButtonText": "text", "Highlight": "selection",
+    "HighlightedText": "selection_text", "ToolTipBase": "tooltip_bg", "ToolTipText": "tooltip_text",
+    "PlaceholderText": "faint", "Link": "accent",
+}
+
+# Plot surfaces of the analysis pages follow the main plot defaults.
+PLOT_BACKGROUND = {"light": (255, 255, 255), "dark": (24, 28, 33)}
+
+
+def palette(theme: str) -> dict:
+    return PALETTES["dark" if theme == "dark" else "light"]
+
+
+def qt_palette_colors(theme: str) -> dict:
+    p = palette(theme)
+    return {role: p[key] for role, key in QT_PALETTE_ROLES.items()}
+
+
+def axis_colors(bg_rgb) -> tuple:
+    """Axis line and tick-label colours: softened, but readable on *bg_rgb*."""
+    r, g, b = bg_rgb[:3]
+    if 0.2126 * r + 0.7152 * g + 0.0722 * b > 140:
+        return (110, 120, 130), (38, 46, 54)
+    return (120, 130, 140), (214, 220, 226)
+
+
+def build_qss(theme: str) -> str:
+    p = dict(palette(theme))
+    p["icons"] = (_ICON_ROOT / ("dark" if theme == "dark" else "light")).as_posix()
+    return _QSS.format(**p)
